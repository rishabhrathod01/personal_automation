# Meal plan WhatsApp — set these in GitHub Secrets (Actions) or here for local runs.
# Copy to .env and fill in values. Do not commit .env.

# Whapi.Cloud API token (from your channel dashboard)
WHAPI_API_TOKEN=

# Whapi group chat ID (e.g. YOUR_GROUP_ID@g.us). Get via: WHAPI_API_TOKEN=... npm run meal-plan:get-groups
WHAPI_GROUP_ID=

# Cook phone for @mention, no spaces (e.g. 91XXXXXXXXXX)
MEAL_PLAN_COOK_PHONE=

# Google Doc ID of the meal plan (the long ID from the doc URL: .../d/DOC_ID/edit)
MEAL_PLAN_DOC_ID=
